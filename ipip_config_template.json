{
  "num_iterations": 3,
  "num_md_seeds": 10,
  "num_md_seeds_per_iter": 5,
  "finetune_data": "./datasets/finetune_data.pt",
  "data_retention_rate": 0.5,
  "convergence_threshold": 0.01,
  "results_dir": "./ipip_results",
  "batch_size": 32,
  "num_workers": 8,
  "device": "cuda",
  "model_config": {
    "name": "painn",
    "num_targets": 1,
    "output_dim": 1,
    "readout": "sum",
    "use_pbc": false,
    "direct_forces": false,
    "num_layers": 4,
    "hidden_channels": 128,
    "cutoff": 5.0,
    "num_radial": 64,
    "head": 16,
    "compute_forces": true
  },
  "training_config": {
    "bz": 32,
    "num_workers": 48,
    "clip_grad": true,
    "gradient_clip_val": 0.1,
    "ema": false,
    "lr_schedule_type": "step",
    "lr_schedule_config": {
      "gamma": 0.85,
      "step_size": 50
    }
  }
}
